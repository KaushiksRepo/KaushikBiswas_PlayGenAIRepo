{
  "name": "playgenai",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright + Cucumber BDD automation framework",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "playgenai": "tsx src/RunFramework.ts",
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:sanity": "cucumber-js --tags @sanity",
    "test:dev": "cross-env ENV=dev cucumber-js",
    "test:qa": "cross-env ENV=qa cucumber-js",
    "test:uat": "cross-env ENV=uat cucumber-js",
    "test:stage": "cross-env ENV=stage cucumber-js",
    "test:parallel": "cucumber-js --parallel 4",
    "test:chromium": "cross-env BROWSER=chromium cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:mobile": "cross-env BROWSER=mobile-chrome cucumber-js",
    "report:generate": "npx ts-node scripts/generate-report.ts --clean",
    "report:open": "npx ts-node scripts/generate-report.ts --clean --open",
    "run:custom": "npx ts-node scripts/run-tests.ts",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf reports/ logs/ auth/*.json",
    "pretest": "rimraf reports/allure-results"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "automation",
    "typescript",
    "enterprise"
  ],
  "type": "commonjs",
  "dependencies": {
    "@faker-js/faker": "^9.7.0",
    "axios": "^1.19.0",
    "dotenv": "^16.6.1",
    "openai": "^6.49.0",
    "playwright": "^1.62.1",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "allure-cucumberjs": "^3.0.0",
    "allure-js-commons": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaushikbiswasgit/KaushikBiswas_PlayGenAI.git"
  },
  "bugs": {
    "url": "https://github.com/kaushikbiswasgit/KaushikBiswas_PlayGenAI/issues"
  },
  "homepage": "https://github.com/kaushikbiswasgit/KaushikBiswas_PlayGenAI#readme"
}
